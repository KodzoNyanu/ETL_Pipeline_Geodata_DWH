<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>05_silver_distances</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Nettoie et charge les distances Google API vers silver.distance_matrix</description>
    <pipeline_type>Normal</pipeline_type>
    <parameters></parameters>
    <created_user>etl</created_user>
    <created_date>2026/05/27 00:00:00.000</created_date>
    <modified_user>etl</modified_user>
    <modified_date>2026/05/27 00:00:00.000</modified_date>
  </info>
  <notepads></notepads>
  <order>
    <hop><from>Read Bronze JSON</from><to>Load silver.distance_matrix</to><enabled>Y</enabled></hop>
  </order>

  <!-- Lire les données Bronze depuis le staging -->
  <transform>
    <name>Read Bronze JSON</name>
    <type>JsonInput</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <include>N</include>
    <include_field/>
    <rownum>N</rownum>
    <addresultfile>N</addresultfile>
    <readurl>N</readurl>
    <removeSourceField>N</removeSourceField>
    <isAFile>N</isAFile>
    <isInFields>N</isInFields>
    <IsIgnoreEmptyFile>N</IsIgnoreEmptyFile>
    <doNotFailIfNoFile>Y</doNotFailIfNoFile>
    <ignoreMissingPath>Y</ignoreMissingPath>
    <defaultPathLeafToNull>Y</defaultPathLeafToNull>
    <rowLimit>0</rowLimit>
    <encoding>UTF-8</encoding>
    <file>
      <name>/staging/enrichment/distance_matrix.json</name>
      <filemask/>
      <exclude_filemask/>
      <file_required>Y</file_required>
      <include_subfolders>N</include_subfolders>
    </file>
    <fields>
      <field>
        <name>origin_query</name>
        <path>$.data[*].origin_query</path>
        <type>String</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>origin_address</name>
        <path>$.data[*].origin_address</path>
        <type>String</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>destination_address</name>
        <path>$.data[*].destination_address</path>
        <type>String</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>distance_meters</name>
        <path>$.data[*].distance_meters</path>
        <type>Integer</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>duration_seconds</name>
        <path>$.data[*].duration_seconds</path>
        <type>Integer</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>retrieved_at</name>
        <path>$.data[*].retrieved_at</path>
        <type>String</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>element_status</name>
        <path>$.data[*].element_status</path>
        <type>String</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <!-- destination_query : ville brute envoyée à l'API (ex: "Alpnach Dorf, CH")
           Sert de clé de jointure avec dim_shipment_headers.ship_to_city via SPLIT_PART -->
      <field>
        <name>destination_query</name>
        <path>$.data[*].destination_query</path>
        <type>String</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
    </fields>
    <attributes/>
    <GUI><xloc>100</xloc><yloc>200</yloc></GUI>
  </transform>

  <!-- Charger dans le schéma Silver (TRUNCATE + INSERT) -->
  <transform>
    <name>Load silver.distance_matrix</name>
    <type>TableOutput</type>
    <distribute>N</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>postgres_gold</connection>
    <schema>silver</schema>
    <table>distance_matrix</table>
    <commit>100</commit>
    <truncate>Y</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
      <field>
        <column_name>origin_query</column_name>
        <stream_name>origin_query</stream_name>
      </field>
      <field>
        <column_name>origin_address</column_name>
        <stream_name>origin_address</stream_name>
      </field>
      <field>
        <column_name>destination_address</column_name>
        <stream_name>destination_address</stream_name>
      </field>
      <field>
        <column_name>distance_meters</column_name>
        <stream_name>distance_meters</stream_name>
      </field>
      <field>
        <column_name>duration_seconds</column_name>
        <stream_name>duration_seconds</stream_name>
      </field>
      <field>
        <column_name>retrieved_at</column_name>
        <stream_name>retrieved_at</stream_name>
      </field>
      <field>
        <column_name>element_status</column_name>
        <stream_name>element_status</stream_name>
      </field>
      <field>
        <column_name>destination_query</column_name>
        <stream_name>destination_query</stream_name>
      </field>
    </fields>
    <attributes/>
    <GUI><xloc>420</xloc><yloc>200</yloc></GUI>
  </transform>

  <transform_error_handling></transform_error_handling>
  <attributes/>
</pipeline>
