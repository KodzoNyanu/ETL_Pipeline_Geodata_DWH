<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>06_silver_flat_files</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Charge le CSV mergé data_merged.csv (541909 lignes : data.json + data.csv, 2010-12-01→2011-12-09) → silver.ecommerce_lines</description>
    <pipeline_type>Normal</pipeline_type>
    <parameters></parameters>
    <created_user>etl</created_user>
    <created_date>2026/05/27 00:00:00.000</created_date>
    <modified_user>etl</modified_user>
    <modified_date>2026/05/27 00:00:00.000</modified_date>
  </info>
  <notepads></notepads>
  <order>
    <hop><from>Read Bronze Merged JSON</from><to>Load silver.ecommerce_lines</to><enabled>Y</enabled></hop>
  </order>

  <!-- Lire le CSV mergé (data.json + data.csv fusionnés = 541909 lignes, 2010-12-01→2011-12-09) -->
  <transform>
    <name>Read Bronze Merged JSON</name>
    <type>CSVInput</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <filename>/staging/flat_files/data_merged.csv</filename>
    <filename_field/>
    <rownum_field/>
    <include_filename>N</include_filename>
    <separator>,</separator>
    <enclosure>&quot;</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>Y</newline_possible>
    <encoding>UTF-8</encoding>
    <fields>
      <field><name>InvoiceNo</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>StockCode</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>Description</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>Quantity</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>InvoiceDate</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>UnitPrice</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>CustomerID</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>Country</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>both</trim_type></field>
    </fields>
    <attributes/>
    <GUI><xloc>100</xloc><yloc>200</yloc></GUI>
  </transform>

  <!-- Charger dans le schéma Silver (TRUNCATE + INSERT batch 1000) -->
  <transform>
    <name>Load silver.ecommerce_lines</name>
    <type>TableOutput</type>
    <distribute>N</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>postgres_gold</connection>
    <schema>silver</schema>
    <table>ecommerce_lines</table>
    <commit>1000</commit>
    <truncate>Y</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
      <field><column_name>invoice_no</column_name><stream_name>InvoiceNo</stream_name></field>
      <field><column_name>stock_code</column_name><stream_name>StockCode</stream_name></field>
      <field><column_name>description</column_name><stream_name>Description</stream_name></field>
      <field><column_name>quantity</column_name><stream_name>Quantity</stream_name></field>
      <field><column_name>invoice_date</column_name><stream_name>InvoiceDate</stream_name></field>
      <field><column_name>unit_price</column_name><stream_name>UnitPrice</stream_name></field>
      <field><column_name>customer_id</column_name><stream_name>CustomerID</stream_name></field>
      <field><column_name>country</column_name><stream_name>Country</stream_name></field>
    </fields>
    <attributes/>
    <GUI><xloc>500</xloc><yloc>200</yloc></GUI>
  </transform>

  <transform_error_handling></transform_error_handling>
  <attributes/>
</pipeline>
