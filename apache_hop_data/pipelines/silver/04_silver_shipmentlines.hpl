<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>04_silver_shipmentlines</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Nettoie et charge les lignes d'expéditions vers silver.salesshipmentline</description>
    <pipeline_type>Normal</pipeline_type>
    <parameters></parameters>
    <created_user>etl</created_user>
    <created_date>2026/05/27 00:00:00.000</created_date>
    <modified_user>etl</modified_user>
    <modified_date>2026/05/27 00:00:00.000</modified_date>
  </info>
  <notepads></notepads>
  <order>
    <hop><from>Read Bronze JSON</from><to>Load silver.salesshipmentline</to><enabled>Y</enabled></hop>
  </order>

  <!-- Lire les données Bronze depuis le staging -->
  <transform>
    <name>Read Bronze JSON</name>
    <type>JsonInput</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <include>N</include>
    <include_field/>
    <rownum>N</rownum>
    <addresultfile>N</addresultfile>
    <readurl>N</readurl>
    <removeSourceField>N</removeSourceField>
    <isAFile>N</isAFile>
    <isInFields>N</isInFields>
    <IsIgnoreEmptyFile>N</IsIgnoreEmptyFile>
    <doNotFailIfNoFile>Y</doNotFailIfNoFile>
    <ignoreMissingPath>Y</ignoreMissingPath>
    <defaultPathLeafToNull>Y</defaultPathLeafToNull>
    <rowLimit>0</rowLimit>
    <encoding>UTF-8</encoding>
    <file>
      <name>/staging/database/salesshipmentline.json</name>
      <filemask/>
      <exclude_filemask/>
      <file_required>Y</file_required>
      <include_subfolders>N</include_subfolders>
    </file>
    <fields>
      <field>
        <name>document_no</name>
        <path>$.data[*].document_no</path>
        <type>String</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>line_no</name>
        <path>$.data[*].line_no</path>
        <type>String</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>item_no</name>
        <path>$.data[*].item_no</path>
        <type>String</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>quantity</name>
        <path>$.data[*].quantity</path>
        <type>String</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>unit_of_measure_code</name>
        <path>$.data[*].unit_of_measure_code</path>
        <type>String</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
    </fields>
    <attributes/>
    <GUI><xloc>100</xloc><yloc>200</yloc></GUI>
  </transform>

  <!-- Charger dans le schéma Silver (TRUNCATE + INSERT) -->
  <transform>
    <name>Load silver.salesshipmentline</name>
    <type>TableOutput</type>
    <distribute>N</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>postgres_gold</connection>
    <schema>silver</schema>
    <table>salesshipmentline</table>
    <commit>100</commit>
    <truncate>Y</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
      <field>
        <column_name>document_no</column_name>
        <stream_name>document_no</stream_name>
      </field>
      <field>
        <column_name>line_no</column_name>
        <stream_name>line_no</stream_name>
      </field>
      <field>
        <column_name>item_no</column_name>
        <stream_name>item_no</stream_name>
      </field>
      <field>
        <column_name>quantity</column_name>
        <stream_name>quantity</stream_name>
      </field>
      <field>
        <column_name>unit_of_measure_code</column_name>
        <stream_name>unit_of_measure_code</stream_name>
      </field>
    </fields>
    <attributes/>
    <GUI><xloc>420</xloc><yloc>200</yloc></GUI>
  </transform>

  <transform_error_handling></transform_error_handling>
  <attributes/>
</pipeline>
