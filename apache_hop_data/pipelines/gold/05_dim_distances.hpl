<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>05_dim_distances</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Charge la dimension distances depuis /staging/enrichment/distance_matrix.json vers PostgreSQL Gold (rechargement complet)</description>
    <pipeline_type>Normal</pipeline_type>
    <parameters></parameters>
    <created_user>etl</created_user>
    <created_date>2026/05/25 00:00:00.000</created_date>
    <modified_user>etl</modified_user>
    <modified_date>2026/05/25 00:00:00.000</modified_date>
  </info>
  <notepads></notepads>
  <order>
    <hop><from>Read from silver.distance_matrix</from><to>Compute km and min</to><enabled>Y</enabled></hop>
    <hop><from>Compute km and min</from><to>Load dim_distances</to><enabled>Y</enabled></hop>
  </order>

  <!-- STEP 1: Read distance matrix enrichment file produced by n8n WF-04 -->
  <!-- File format:
    { "metadata": {...}, "data": [
      { "origin_query": "...", "destination_query": "...",
        "origin_address": "...", "destination_address": "...",
        "distance_meters": 12345, "duration_seconds": 678,
        "api_status": "OK", "element_status": "OK",
        "retrieved_at": "2026-05-25T..." }
    ]}
  -->
    <!-- Lire depuis la couche Silver (PostgreSQL) -->
  <transform>
    <name>Read from silver.distance_matrix</name>
    <type>TableInput</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>postgres_gold</connection>
    <sql>SELECT
  origin_query        AS order_id,
  origin_address      AS origin,
  destination_address AS destination,
  distance_meters,
  duration_seconds,
  retrieved_at        AS extracted_at_str,
  element_status,
  -- Dériver location_code depuis l'adresse d'origine (sans modifier WF-04 ni les données sources)
  -- Mapping : adresse Swiss connue → code entrepôt
  CASE
    WHEN origin_query ILIKE '%Quai%'       OR origin_query ILIKE '%Genève%'   THEN 'MAGASIN-VERT'
    WHEN origin_query ILIKE '%Gare%'       OR origin_query ILIKE '%Lausanne%' THEN 'MAGASIN-BLANC'
    WHEN origin_query ILIKE '%Bahnhof%'    OR origin_query ILIKE '%Zürich%'   THEN 'MAGASIN-JAUNE'
    WHEN origin_query ILIKE '%Bundesplatz%' OR origin_query ILIKE '%Bern%'    THEN 'MAGASIN-ROUGE'
    ELSE NULL
  END                 AS location_code,
  -- Dériver destination_city : destination_query = "Alpnach Dorf, CH"
  -- SPLIT_PART sur ", " donne la ville brute = ship_to_city dans dim_shipment_headers
  -- Si destination_query ne contient pas de virgule → juste un pays → city = NULL
  CASE
    WHEN destination_query LIKE '%, %' THEN SPLIT_PART(destination_query, ', ', 1)
    ELSE NULL
  END                 AS destination_city
FROM silver.distance_matrix</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI><xloc>100</xloc><yloc>200</yloc></GUI>
  </transform>

  <!-- STEP 2: Convert meters→km and seconds→minutes; only keep OK elements -->
  <transform>
    <name>Compute km and min</name>
    <type>ScriptValueMod</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Compute km and min</jsScript_name>
        <jsScript_script><![CDATA[
// Convert meters to km (rounded to 2 decimal places)
var distance_km = (distance_meters != null && distance_meters > 0)
    ? Math.round(distance_meters / 10.0) / 100.0
    : null;

// Convert seconds to minutes (rounded to 2 decimal places)
var duration_min = (duration_seconds != null && duration_seconds > 0)
    ? Math.round(duration_seconds / 0.6) / 100.0
    : null;

// Parse ISO timestamp to Date (Hop Date type)
var extracted_at = null;
if (extracted_at_str != null && extracted_at_str != '') {
    try {
        var fmt = new java.text.SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'");
        fmt.setTimeZone(java.util.TimeZone.getTimeZone("UTC"));
        extracted_at = fmt.parse(extracted_at_str);
    } catch(e) {
        extracted_at = new java.util.Date();
    }
}
]]></jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>distance_km</name>
        <rename>distance_km</rename>
        <type>BigNumber</type>
        <length>10</length>
        <precision>2</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>duration_min</name>
        <rename>duration_min</rename>
        <type>BigNumber</type>
        <length>10</length>
        <precision>2</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>extracted_at</name>
        <rename>extracted_at</rename>
        <type>Date</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <GUI><xloc>350</xloc><yloc>200</yloc></GUI>
  </transform>

  <!-- STEP 3: Full reload — truncate then insert into dim_distances -->
  <!-- Note: dim_distances has SERIAL PK (id) with no natural unique key,
       so we do a full reload on each ETL run. -->
  <transform>
    <name>Load dim_distances</name>
    <type>TableOutput</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>postgres_gold</connection>
    <schema>public</schema>
    <table>dim_distances</table>
    <commit>100</commit>
    <truncate>Y</truncate>
    <ignore>N</ignore>
    <specify_fields>Y</specify_fields>
    <onlyWhenHaveRows>N</onlyWhenHaveRows>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
      <field>
        <column_name>order_id</column_name>
        <stream_name>order_id</stream_name>
      </field>
      <field>
        <column_name>origin</column_name>
        <stream_name>origin</stream_name>
      </field>
      <field>
        <column_name>destination</column_name>
        <stream_name>destination</stream_name>
      </field>
      <field>
        <column_name>distance_km</column_name>
        <stream_name>distance_km</stream_name>
      </field>
      <field>
        <column_name>duration_min</column_name>
        <stream_name>duration_min</stream_name>
      </field>
      <field>
        <column_name>extracted_at</column_name>
        <stream_name>extracted_at</stream_name>
      </field>
      <!-- Clés de jointure avec dim_shipment_headers pour analyses logistiques -->
      <field>
        <column_name>location_code</column_name>
        <stream_name>location_code</stream_name>
      </field>
      <field>
        <column_name>destination_city</column_name>
        <stream_name>destination_city</stream_name>
      </field>
    </fields>
    <attributes/>
    <GUI><xloc>620</xloc><yloc>200</yloc></GUI>
  </transform>

  <transform_error_handling></transform_error_handling>
  <attributes/>
</pipeline>
