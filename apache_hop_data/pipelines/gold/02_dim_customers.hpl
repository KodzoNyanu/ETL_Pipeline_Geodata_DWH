<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>02_dim_customers</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Charge la dimension clients depuis /staging/database/clients.json vers PostgreSQL Gold</description>
    <pipeline_type>Normal</pipeline_type>
    <parameters></parameters>
    <created_user>etl</created_user>
    <created_date>2026/05/25 00:00:00.000</created_date>
    <modified_user>etl</modified_user>
    <modified_date>2026/05/25 00:00:00.000</modified_date>
  </info>
  <notepads></notepads>
  <order>
    <hop><from>Read from silver.clients</from><to>Load dim_customers</to><enabled>Y</enabled></hop>
  </order>

  <!-- STEP 1: Read from staging JSON file produced by n8n WF-03 -->
  <!-- NOTE: JSONPaths use field names from source PostgreSQL DB (Business Central export).
       Adjust $.data[*].FIELD_NAME if your source table uses different column names.
       Common aliases:
         customer_id: no, customer_no, no_, custno
         name: name, customer_name, nom
         country: country, country_region_code, pays
         post_code: post_code, postcode, zip
         location_code: location_code, code_depot
         currency_code: currency_code, devise
         salesperson_code: salesperson_code, commercial
  -->
    <!-- Lire depuis la couche Silver (PostgreSQL) -->
  <transform>
    <name>Read from silver.clients</name>
    <type>TableInput</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>postgres_gold</connection>
    <sql>SELECT
  customer_no       AS customer_id,
  name,
  country_region_code AS country,
  post_code,
  location_code,
  currency_code,
  salesperson_code
FROM silver.clients
WHERE customer_no IS NOT NULL AND customer_no &lt;&gt; ''</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI><xloc>100</xloc><yloc>200</yloc></GUI>
  </transform>

  <!-- STEP 2: Upsert into PostgreSQL dim_customers -->
  <transform>
    <name>Load dim_customers</name>
    <type>InsertUpdate</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>postgres_gold</connection>
    <lookup>
      <schema>public</schema>
      <table>dim_customers</table>
      <key>
        <name>customer_id</name>
        <field>customer_id</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>customer_id</name>
        <rename>customer_id</rename>
        <update>N</update>
      </value>
      <value>
        <name>name</name>
        <rename>name</rename>
        <update>Y</update>
      </value>
      <value>
        <name>country</name>
        <rename>country</rename>
        <update>Y</update>
      </value>
      <value>
        <name>post_code</name>
        <rename>post_code</rename>
        <update>Y</update>
      </value>
      <value>
        <name>location_code</name>
        <rename>location_code</rename>
        <update>Y</update>
      </value>
      <value>
        <name>currency_code</name>
        <rename>currency_code</rename>
        <update>Y</update>
      </value>
      <value>
        <name>salesperson_code</name>
        <rename>salesperson_code</rename>
        <update>Y</update>
      </value>
    </lookup>
    <attributes/>
    <GUI><xloc>420</xloc><yloc>200</yloc></GUI>
  </transform>

  <transform_error_handling></transform_error_handling>
  <attributes/>
</pipeline>
