<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>03_dim_articles</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Charge la dimension articles depuis /staging/database/articles.json vers PostgreSQL Gold</description>
    <pipeline_type>Normal</pipeline_type>
    <parameters></parameters>
    <created_user>etl</created_user>
    <created_date>2026/05/25 00:00:00.000</created_date>
    <modified_user>etl</modified_user>
    <modified_date>2026/05/25 00:00:00.000</modified_date>
  </info>
  <notepads></notepads>
  <order>
    <hop><from>Read from silver.articles</from><to>Load dim_articles</to><enabled>Y</enabled></hop>
  </order>

  <!-- STEP 1: Read from staging JSON file produced by n8n WF-03 -->
  <!-- NOTE: Adjust JSONPaths if source column names differ.
       Common Business Central article field names:
         article_id: no, item_no, article_no
         description: description, description_2
         unit_of_measure: base_unit_of_measure, unit_of_measure_code
         type: type
         item_category: item_category_code, famille
         unit_price: unit_price
         unit_cost: unit_cost
         costing_method: costing_method
  -->
    <!-- Lire depuis la couche Silver (PostgreSQL) -->
  <transform>
    <name>Read from silver.articles</name>
    <type>TableInput</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>postgres_gold</connection>
    <sql>SELECT
  item_no              AS article_id,
  description,
  base_unit_of_measure AS unit_of_measure,
  item_type            AS type,
  item_category_code   AS item_category,
  unit_price,
  unit_cost,
  costing_method
FROM silver.articles
WHERE item_no IS NOT NULL AND item_no &lt;&gt; ''</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI><xloc>100</xloc><yloc>200</yloc></GUI>
  </transform>

  <!-- STEP 2: Upsert into PostgreSQL dim_articles -->
  <transform>
    <name>Load dim_articles</name>
    <type>InsertUpdate</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>postgres_gold</connection>
    <lookup>
      <schema>public</schema>
      <table>dim_articles</table>
      <key>
        <name>article_id</name>
        <field>article_id</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>article_id</name>
        <rename>article_id</rename>
        <update>N</update>
      </value>
      <value>
        <name>description</name>
        <rename>description</rename>
        <update>Y</update>
      </value>
      <value>
        <name>unit_of_measure</name>
        <rename>unit_of_measure</rename>
        <update>Y</update>
      </value>
      <value>
        <name>type</name>
        <rename>type</rename>
        <update>Y</update>
      </value>
      <value>
        <name>item_category</name>
        <rename>item_category</rename>
        <update>Y</update>
      </value>
      <value>
        <name>unit_price</name>
        <rename>unit_price</rename>
        <update>Y</update>
      </value>
      <value>
        <name>unit_cost</name>
        <rename>unit_cost</rename>
        <update>Y</update>
      </value>
      <value>
        <name>costing_method</name>
        <rename>costing_method</rename>
        <update>Y</update>
      </value>
    </lookup>
    <attributes/>
    <GUI><xloc>420</xloc><yloc>200</yloc></GUI>
  </transform>

  <transform_error_handling></transform_error_handling>
  <attributes/>
</pipeline>
