<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>04_dim_shipment_headers</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Charge la dimension entêtes expéditions depuis /staging/database/salesshipmentheader.json vers PostgreSQL Gold</description>
    <pipeline_type>Normal</pipeline_type>
    <parameters></parameters>
    <created_user>etl</created_user>
    <created_date>2026/05/25 00:00:00.000</created_date>
    <modified_user>etl</modified_user>
    <modified_date>2026/05/25 00:00:00.000</modified_date>
  </info>
  <notepads></notepads>
  <order>
    <hop><from>Read from silver.salesshipmentheader</from><to>Parse Dates</to><enabled>Y</enabled></hop>
    <hop><from>Parse Dates</from><to>Load dim_shipment_headers</to><enabled>Y</enabled></hop>
  </order>

  <!-- STEP 1: Read from staging JSON file produced by n8n WF-03 -->
  <!-- NOTE: Adjust JSONPaths if source column names differ.
       Common Business Central sales shipment header field names:
         header_id: no
         customer_id: sell_to_customer_no, customer_no
         order_no: order_no
         shipment_date: shipment_date (ISO date)
         posting_date: posting_date (ISO date)
         ship_to_city: ship_to_city
         ship_to_country: ship_to_country_code
         ship_to_post_code: ship_to_post_code
         location_code: location_code
         shipment_method: shipment_method_code
         salesperson_code: salesperson_code
  -->
    <!-- Lire depuis la couche Silver (PostgreSQL) -->
  <transform>
    <name>Read from silver.salesshipmentheader</name>
    <type>TableInput</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>postgres_gold</connection>
    <sql>SELECT
  shipment_no          AS header_id,
  sell_to_customer_no  AS customer_id,
  order_no,
  posting_date         AS posting_date_str,
  ship_to_city,
  ship_to_country_code AS ship_to_country,
  ship_to_post_code,
  location_code,
  shipment_method_code AS shipment_method,
  salesperson_code
FROM silver.salesshipmentheader
WHERE shipment_no IS NOT NULL AND shipment_no &lt;&gt; ''</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI><xloc>100</xloc><yloc>200</yloc></GUI>
  </transform>


  <!-- STEP 2: Convertir posting_date_str (RFC 822) en Date Java -->
  <transform>
    <name>Parse Dates</name>
    <type>ScriptValueMod</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Parse Dates</jsScript_name>
        <jsScript_script><![CDATA[
var posting_date = null;
var shipment_date = null;

if (posting_date_str != null && posting_date_str.toString().trim() !== '') {
    var raw = posting_date_str.toString().trim();
    var FORMATS = [
        "EEE, dd MMM yyyy HH:mm:ss z",
        "dd MMM yyyy HH:mm:ss z",
        "yyyy-MM-dd'T'HH:mm:ss",
        "yyyy-MM-dd"
    ];
    for (var i = 0; i < FORMATS.length; i++) {
        try {
            var fmt = new java.text.SimpleDateFormat(FORMATS[i], java.util.Locale.ENGLISH);
            fmt.setLenient(false);
            posting_date = fmt.parse(raw);
            break;
        } catch(ex) { }
    }
}
]]></jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>posting_date</name>
        <rename>posting_date</rename>
        <type>Date</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>shipment_date</name>
        <rename>shipment_date</rename>
        <type>Date</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <GUI><xloc>400</xloc><yloc>200</yloc></GUI>
  </transform>

  <!-- STEP 3: Upsert into PostgreSQL dim_shipment_headers -->
  <transform>
    <name>Load dim_shipment_headers</name>
    <type>InsertUpdate</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>postgres_gold</connection>
    <lookup>
      <schema>public</schema>
      <table>dim_shipment_headers</table>
      <key>
        <name>header_id</name>
        <field>header_id</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>header_id</name>
        <rename>header_id</rename>
        <update>N</update>
      </value>
      <value>
        <name>customer_id</name>
        <rename>customer_id</rename>
        <update>Y</update>
      </value>
      <value>
        <name>order_no</name>
        <rename>order_no</rename>
        <update>Y</update>
      </value>
      <value>
        <name>shipment_date</name>
        <rename>shipment_date</rename>
        <update>Y</update>
      </value>
      <value>
        <name>posting_date</name>
        <rename>posting_date</rename>
        <update>Y</update>
      </value>
      <value>
        <name>ship_to_city</name>
        <rename>ship_to_city</rename>
        <update>Y</update>
      </value>
      <value>
        <name>ship_to_country</name>
        <rename>ship_to_country</rename>
        <update>Y</update>
      </value>
      <value>
        <name>ship_to_post_code</name>
        <rename>ship_to_post_code</rename>
        <update>Y</update>
      </value>
      <value>
        <name>location_code</name>
        <rename>location_code</rename>
        <update>Y</update>
      </value>
      <value>
        <name>shipment_method</name>
        <rename>shipment_method</rename>
        <update>Y</update>
      </value>
      <value>
        <name>salesperson_code</name>
        <rename>salesperson_code</rename>
        <update>Y</update>
      </value>
    </lookup>
    <attributes/>
    <GUI><xloc>700</xloc><yloc>200</yloc></GUI>
  </transform>

  <transform_error_handling></transform_error_handling>
  <attributes/>
</pipeline>
