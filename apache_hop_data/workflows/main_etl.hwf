<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>main_etl</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Pipeline ETL complet Bronze→Silver→Gold : appelé par n8n dès que WF-04 détecte de nouvelles données Distance Matrix (temps réel)</description>
  <extended_description/>
  <workflow_version/>
  <created_user>etl</created_user>
  <created_date>2026/05/27 00:00:00.000</created_date>
  <modified_user>etl</modified_user>
  <modified_date>2026/05/27 00:00:00.000</modified_date>
  <parameters></parameters>
  <actions>
    <action>
      <name>Start</name>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>0</hour><intervalMinutes>0</intervalMinutes><intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes><repeat>N</repeat><schedulerType>0</schedulerType><weekDay>1</weekDay>
      <parallel>N</parallel><xloc>80</xloc><yloc>200</yloc><attributes_hac/>
    </action>

    <!-- ── COUCHE SILVER ───────────────────────────────── -->
    <action>
      <name>ETL Silver</name>
      <description>Staging Bronze → silver.* (nettoyage et normalisation)</description>
      <type>WORKFLOW</type>
      <attributes/>
      <add_date>N</add_date><add_time>N</add_time>
      <filename>${PROJECT_HOME}/workflows/main_etl_silver.hwf</filename>
      <loglevel>Basic</loglevel>
      <params_from_previous>N</params_from_previous>
      <parameters><pass_all_parameters>Y</pass_all_parameters></parameters>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile><set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <create_parent_folder>N</create_parent_folder>
      <parallel>N</parallel><xloc>280</xloc><yloc>200</yloc><attributes_hac/>
    </action>

    <!-- ── COUCHE GOLD ────────────────────────────────── -->
    <action>
      <name>ETL Gold</name>
      <description>silver.* → PostgreSQL Gold DWH (dimensions et faits)</description>
      <type>WORKFLOW</type>
      <attributes/>
      <add_date>N</add_date><add_time>N</add_time>
      <filename>${PROJECT_HOME}/workflows/main_etl_gold.hwf</filename>
      <loglevel>Basic</loglevel>
      <params_from_previous>N</params_from_previous>
      <parameters><pass_all_parameters>Y</pass_all_parameters></parameters>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile><set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <create_parent_folder>N</create_parent_folder>
      <parallel>N</parallel><xloc>480</xloc><yloc>200</yloc><attributes_hac/>
    </action>

    <!-- ── CLEANUP SILVER (staging temporaire) ──────── -->
    <action>
      <name>Cleanup Silver</name>
      <description>Purge les tables silver.* après chargement Gold — le DWH ne doit contenir que Gold</description>
      <type>SQL</type>
      <attributes/>
      <connection>postgres_gold</connection>
      <sql>TRUNCATE TABLE silver.clients;
TRUNCATE TABLE silver.articles;
TRUNCATE TABLE silver.salesshipmentheader;
TRUNCATE TABLE silver.salesshipmentline;
TRUNCATE TABLE silver.distance_matrix;
TRUNCATE TABLE silver.ecommerce_lines;</sql>
      <useVariableSubstitution>N</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sendOneStatement>N</sendOneStatement>
      <parallel>N</parallel><xloc>680</xloc><yloc>200</yloc><attributes_hac/>
    </action>

    <action>
      <name>ETL Termine</name>
      <description>Pipeline Bronze→Silver→Gold completé avec succès — DWH Gold uniquement</description>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel><xloc>880</xloc><yloc>200</yloc><attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop><from>Start</from><to>ETL Silver</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>Y</unconditional></hop>
    <hop><from>ETL Silver</from><to>ETL Gold</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>ETL Gold</from><to>Cleanup Silver</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>Cleanup Silver</from><to>ETL Termine</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
  </hops>
  <notepads></notepads>
  <attributes/>
</workflow>
