<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>main_etl_silver</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Orchestre la couche Silver : lit le staging Bronze, nettoie et charge dans silver.* (PostgreSQL)</description>
  <extended_description/>
  <workflow_version/>
  <created_user>etl</created_user>
  <created_date>2026/05/27 00:00:00.000</created_date>
  <modified_user>etl</modified_user>
  <modified_date>2026/05/27 00:00:00.000</modified_date>
  <parameters></parameters>
  <actions>
    <action>
      <name>Start</name>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>0</hour><intervalMinutes>0</intervalMinutes><intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes><repeat>N</repeat><schedulerType>0</schedulerType><weekDay>1</weekDay>
      <parallel>N</parallel><xloc>80</xloc><yloc>200</yloc><attributes_hac/>
    </action>
    <action>
      <name>01_silver_clients</name>
      <description>Charge les clients Bronze → silver.clients</description>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date><add_time>N</add_time>
      <clear_files>Y</clear_files><clear_rows>Y</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/pipelines/silver/01_silver_clients.hpl</filename>
      <loglevel>Basic</loglevel>
      <parameters><pass_all_parameters>Y</pass_all_parameters></parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile><set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel><xloc>240</xloc><yloc>200</yloc><attributes_hac/>
    </action>
    <action>
      <name>02_silver_articles</name>
      <description>Charge les articles Bronze → silver.articles</description>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date><add_time>N</add_time>
      <clear_files>Y</clear_files><clear_rows>Y</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/pipelines/silver/02_silver_articles.hpl</filename>
      <loglevel>Basic</loglevel>
      <parameters><pass_all_parameters>Y</pass_all_parameters></parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile><set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel><xloc>420</xloc><yloc>200</yloc><attributes_hac/>
    </action>
    <action>
      <name>03_silver_shipmentheader</name>
      <description>Charge les entêtes expéditions Bronze → silver.salesshipmentheader</description>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date><add_time>N</add_time>
      <clear_files>Y</clear_files><clear_rows>Y</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/pipelines/silver/03_silver_shipmentheader.hpl</filename>
      <loglevel>Basic</loglevel>
      <parameters><pass_all_parameters>Y</pass_all_parameters></parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile><set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel><xloc>600</xloc><yloc>200</yloc><attributes_hac/>
    </action>
    <action>
      <name>04_silver_shipmentlines</name>
      <description>Charge les lignes expéditions Bronze → silver.salesshipmentline</description>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date><add_time>N</add_time>
      <clear_files>Y</clear_files><clear_rows>Y</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/pipelines/silver/04_silver_shipmentlines.hpl</filename>
      <loglevel>Basic</loglevel>
      <parameters><pass_all_parameters>Y</pass_all_parameters></parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile><set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel><xloc>780</xloc><yloc>200</yloc><attributes_hac/>
    </action>
    <action>
      <name>05_silver_distances</name>
      <description>Charge les distances Google API → silver.distance_matrix</description>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date><add_time>N</add_time>
      <clear_files>Y</clear_files><clear_rows>Y</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/pipelines/silver/05_silver_distances.hpl</filename>
      <loglevel>Basic</loglevel>
      <parameters><pass_all_parameters>Y</pass_all_parameters></parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile><set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel><xloc>960</xloc><yloc>200</yloc><attributes_hac/>
    </action>
    <action>
      <name>06_silver_flat_files</name>
      <description>Charge le CSV ecommerce Bronze → silver.ecommerce_lines</description>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date><add_time>N</add_time>
      <clear_files>Y</clear_files><clear_rows>Y</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/pipelines/silver/06_silver_flat_files.hpl</filename>
      <loglevel>Basic</loglevel>
      <parameters><pass_all_parameters>Y</pass_all_parameters></parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile><set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel><xloc>1140</xloc><yloc>200</yloc><attributes_hac/>
    </action>
    <action>
      <name>Silver Termine</name>
      <description>Toutes les tables Silver chargees avec succes</description>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel><xloc>1320</xloc><yloc>200</yloc><attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop><from>Start</from><to>01_silver_clients</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>Y</unconditional></hop>
    <hop><from>01_silver_clients</from><to>02_silver_articles</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>02_silver_articles</from><to>03_silver_shipmentheader</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>03_silver_shipmentheader</from><to>04_silver_shipmentlines</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>04_silver_shipmentlines</from><to>05_silver_distances</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>05_silver_distances</from><to>06_silver_flat_files</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>06_silver_flat_files</from><to>Silver Termine</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
  </hops>
  <notepads></notepads>
  <attributes/>
</workflow>
