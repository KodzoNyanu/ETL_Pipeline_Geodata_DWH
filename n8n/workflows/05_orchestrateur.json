  "nodes": [
    {
      "id": "check-sources-bindmount-001",
      "name": "Vérifier fichiers sources",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        340,
        380
      ],
      "parameters": {
        "jsCode": "// Vérifie la présence des fichiers plats dans le bind mount /data_sources/\n// avant de déclencher le pipeline complet.\nconst fs = require('fs');\nconst REQUIRED = [\n  { path: '/data_sources/data.csv',  label: 'data.csv'  },\n  { path: '/data_sources/data.json', label: 'data.json' }\n];\n\nconst missing = [];\nconst present = [];\n\nfor (const f of REQUIRED) {\n  if (fs.existsSync(f.path)) {\n    const stats = fs.statSync(f.path);\n    present.push({ file: f.label, size: stats.size, modified: stats.mtime.toISOString() });\n  } else {\n    missing.push(f.label);\n  }\n}\n\nconst allPresent = missing.length === 0;\nconsole.log(`[WF-05] Fichiers sources : ${present.length}/${REQUIRED.length} présents ${allPresent ? '✅' : '❌'}`);\nif (!allPresent) console.error('[WF-05] Fichiers manquants : ' + missing.join(', '));\n\nreturn [{ json: { allPresent, present, missing, checkedAt: new Date().toISOString() } }];"
      }
    },
    {
      "id": "check-sources-if-001",
      "name": "Fichiers présents ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        580,
        380
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "aa1b2c3d-4e5f-6789-abcd-ef0123456789",
              "leftValue": "={{ $json.allPresent }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "sources-missing-alert-001",
      "name": "Fichiers manquants — Alerter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        820,
        500
      ],
      "parameters": {
        "jsCode": "const e = $input.first().json;\nconsole.error('[WF-05] ❌ Pipeline interrompu — fichiers sources manquants dans /data_sources/ : ' + e.missing.join(', '));\nconsole.error('[WF-05] Vérifier le bind mount Docker : D:\\\\Projet de SI → /data_sources/');\nreturn [{ json: { status: 'ABORTED', reason: 'missing_source_files', missing: e.missing, checkedAt: e.checkedAt } }];"
      }
    },
